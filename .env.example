# Aurum AI Environment Variables
# Version: 2.0 (2026-09-27)

# --- Supabase Database Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional direct Postgres connection string (if using psycopg2 / migration scripts)
SUPABASE_DB_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Telegram Bot Configuration ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Secret token for Telegram webhook verification (RULE-004)
# Must only contain characters A-Z, a-z, 0-9, _, -
TELEGRAM_SECRET_TOKEN=your-random-webhook-secret-token-here

# --- Google Gemini AI Configuration ---
GEMINI_API_KEY=your-google-ai-studio-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Internal Security ---
# Shared secret for cron endpoints (/api/cron/process-alerts) invoked by GitHub Actions
CRON_SECRET=your-internal-cron-shared-secret

# --- Deployment / Base URL ---
APP_URL=https://your-domain.vercel.app

# --- Metal Tax Rates & Defaults ---
# Import duty on gold/silver (10% BCD + 5% AIDC = 15%)
DUTY_PCT=0.15
# GST on physical metal (3%)
GST_PCT=0.03
DEFAULT_TTS_VOICE=hi-IN-SwaraNeural
